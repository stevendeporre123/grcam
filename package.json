{
  "name": "grcam",
  "version": "0.1.0",
  "description": "Noodbediening voor Lumens PTZ-camera's via Extron IPL T S6 (VISCA over TCP)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/visca.test.js && node test/plan.test.js && node test/brighteye.test.js && node test/debug-watch.test.js && node test/visca-decode.test.js && node test/data-store.test.js && node test/updater.test.js && node test/host.test.js && node test/log-format.test.js && node test/mic-api.test.js && node test/packaging.test.js",
    "test:e2e": "node test/e2e-main.test.js",
    "dist": "electron-builder --win portable --publish never"
  },
  "dependencies": {
    "datatables.net": "^3.1.4",
    "datatables.net-dt": "^3.1.4"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "be.smartergrp.ptzbackup",
    "productName": "PTZ Backup",
    "files": [
      "main.js",
      "preload.js",
      "visca.js",
      "brighteye.js",
      "host.js",
      "debug-watch.js",
      "visca-decode.js",
      "data-store.js",
      "updater.js",
      "mic-api.js",
      "config.default.json",
      "plan.default.json",
      "renderer/**",
      "node_modules/datatables.net/js/dataTables.min.js",
      "node_modules/datatables.net-dt/css/dataTables.dataTables.min.css",
      "node_modules/datatables.net-dt/images/**"
    ],
    "win": {
      "target": "portable",
      "artifactName": "PTZ-Backup-${version}-portable.exe"
    }
  }
}
