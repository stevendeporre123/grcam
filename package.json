{
  "name": "grcam",
  "version": "0.1.0",
  "description": "Noodbediening voor Lumens PTZ-camera's via Extron IPL T S6 (VISCA over TCP)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/visca.test.js && node test/plan.test.js && node test/brighteye.test.js && node test/debug-watch.test.js && node test/visca-decode.test.js && node test/data-store.test.js && node test/updater.test.js && node test/host.test.js",
    "test:e2e": "node test/e2e-main.test.js",
    "dist": "electron-builder --win portable --publish never"
  },
  "dependencies": {
    "datatables.net": "^2.1.8",
    "datatables.net-dt": "^2.1.8",
    "jquery": "^3.7.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "be.smartergrp.ptzbackup",
    "productName": "PTZ Backup",
    "files": [
      "main.js",
      "preload.js",
      "visca.js",
      "brighteye.js", "host.js", "debug-watch.js", "visca-decode.js", "data-store.js", "updater.js",
      "config.default.json",
      "plan.default.json",
      "renderer/**",
      "node_modules/jquery/dist/jquery.min.js",
      "node_modules/datatables.net/js/dataTables.min.js",
      "node_modules/datatables.net-dt/css/dataTables.dataTables.min.css",
      "node_modules/datatables.net-dt/images/**"
    ],
    "win": {
      "target": "portable",
      "artifactName": "PTZ-Backup-${version}-portable.exe"
    }
  }
}
